// Default bindings, applied to Godot's InputMap at startup; your changes in the settings (Controls) are saved over them.
// Each action has room for two keyboard-and-mouse bindings and one pad binding; label is what the settings call it, and
// group the list it's in there (movement, combat, or shortcuts if not given).
// keys: physical key names (layout-independent) · mouse: Left/Right/Middle/WheelUp/WheelDown
// buttons: gamepad buttons in SDL layout, so Xbox and PlayStation pads both work
//   (A = Cross, B = Circle, X = Square, Y = Triangle) · axes: axis name + direction.
{
  "deadzone": 0.2,
  "actions": [
    { "name": "move_forward", "label": "Move forward", "group": "movement", "keys": ["W", "Up"], "axes": ["LeftY-"] },
    { "name": "move_back", "label": "Move back", "group": "movement", "keys": ["S", "Down"], "axes": ["LeftY+"] },
    { "name": "move_left", "label": "Move left", "group": "movement", "keys": ["A", "Left"], "axes": ["LeftX-"] },
    { "name": "move_right", "label": "Move right", "group": "movement", "keys": ["D", "Right"], "axes": ["LeftX+"] },
    { "name": "look_left", "label": "Look left", "group": "movement", "axes": ["RightX-"], "deadzone": 0.15 },
    { "name": "look_right", "label": "Look right", "group": "movement", "axes": ["RightX+"], "deadzone": 0.15 },
    { "name": "look_up", "label": "Look up", "group": "movement", "axes": ["RightY-"], "deadzone": 0.15 },
    { "name": "look_down", "label": "Look down", "group": "movement", "axes": ["RightY+"], "deadzone": 0.15 },

    { "name": "fire", "label": "Fire", "group": "combat", "mouse": ["Left"], "axes": ["TriggerRight+"], "deadzone": 0.4 },
    { "name": "sprint", "label": "Sprint", "group": "movement", "keys": ["Shift"], "buttons": ["LeftStick"] },
    { "name": "crouch", "label": "Crouch", "group": "movement", "keys": ["Ctrl", "C"], "buttons": ["B"] },
    { "name": "walk", "label": "Walk", "group": "movement", "keys": ["Alt"] },
    { "name": "refill", "label": "Refill the loader", "group": "combat", "keys": ["R"], "buttons": ["X"] },
    // Opens and shuts the door you're facing (tap), or eases it open (hold). On a pad it shares the refill button:
    // facing a door it works the door, anywhere else it refills.
    { "name": "interact", "label": "Use a door or a ladder", "group": "combat", "keys": ["F"], "buttons": ["X"] },
    { "name": "fire_mode", "label": "Fire mode", "group": "combat", "keys": ["B"], "buttons": ["Y"] },
    { "name": "lean_left", "label": "Lean left", "group": "movement", "keys": ["Q"], "buttons": ["LeftShoulder"] },
    { "name": "lean_right", "label": "Lean right", "group": "movement", "keys": ["E"], "buttons": ["RightShoulder"] },
    { "name": "swap_shoulder", "label": "Swap shoulder", "group": "combat", "keys": ["X"], "mouse": ["Middle"], "buttons": ["RightStick"] },
    { "name": "slide", "label": "Slide", "group": "movement", "keys": ["V"] },
    { "name": "jump", "label": "Jump", "group": "movement", "keys": ["Space"], "buttons": ["A"] },

    { "name": "pause", "label": "Pause", "keys": ["Escape"], "buttons": ["Start"] },
    { "name": "debug_help", "label": "Help", "keys": ["F1"], "buttons": ["Back"] },
    { "name": "debug_arc", "label": "Arc preview", "keys": ["F2"], "buttons": ["DpadUp"] },
    { "name": "debug_stress", "label": "Bot overlay / stress test", "keys": ["F3"], "buttons": ["DpadDown"] },
    { "name": "debug_perf", "label": "Performance overlay", "keys": ["F4"], "buttons": ["DpadRight"] },
    { "name": "toggle_head_bob", "label": "Head-bob on/off", "keys": ["F5"] },
    { "name": "debug_reset_gear", "label": "Reset gear (training)", "keys": ["F6"], "buttons": ["DpadLeft"] },
    { "name": "toggle_crosshair", "label": "Crosshair on/off", "keys": ["F7"] },
    { "name": "toggle_vsync", "label": "V-sync on/off", "keys": ["F8"] },
    { "name": "reload_data", "label": "Reload the data", "keys": ["F9"] },
    { "name": "toggle_invert_y", "label": "Invert Y on/off", "keys": ["F10"] },
    { "name": "toggle_fullscreen", "label": "Full screen on/off", "keys": ["F11"] },
    { "name": "fov_down", "label": "Narrower view", "keys": ["BracketLeft"] },
    { "name": "fov_up", "label": "Wider view", "keys": ["BracketRight"] },
    { "name": "sensitivity_down", "label": "Mouse slower", "keys": ["Minus"] },
    { "name": "sensitivity_up", "label": "Mouse faster", "keys": ["Equal"] },
    { "name": "cycle_graphics", "label": "Next graphics preset", "keys": ["F12"] }
  ]
}
