        { "segment": 0, "at_m": 1.7, "width_m": 1.1, "sill_m": 1.95, "height_m": 0.65, "kind": "window" },
        { "segment": 0, "at_m": 4.0, "width_m": 1.1, "sill_m": 1.95, "height_m": 0.65, "kind": "window" },
        { "segment": 0, "at_m": 6.3, "width_m": 1.1, "sill_m": 1.95, "height_m": 0.65, "kind": "window" },
        { "segment": 2, "at_m": 6.9, "width_m": 0.9, "height_m": 2.1, "kind": "door", "leaf": { "door": "panel", "hinge": "end", "swing": "left", "start": "ajar" } }
      ]
    }
  ],
  "roof": { "rect_m": [-0.3, -0.3, 8.3, 6.3], "material": "roof_felt", "ceilingMaterial": "panel_white" },
