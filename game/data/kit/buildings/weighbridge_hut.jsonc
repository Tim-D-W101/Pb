// Weighbridge hut: a brick hut 3 × 2.5 m beside the weighbridge, a window onto the plate and a door at the side.
// Wall segments: 0 north (x 0→3), 1 east (z 0→2.5), 2 south (x 3→0, at_m = 3 − x), 3 west (z 2.5→0, at_m = 2.5 − z).
{
  "id": "weighbridge_hut",
  "displayName": "Weighbridge hut",
  "storeys_m": [2.6],
  "slabThickness_m": 0.15,
  "footprint_m": [0, 0, 3, 2.5],
  "floorMaterial": "concrete_floor",
  "frames": "steel_painted",
  "walls": [
    {
      "storey": 0, "points_m": [[0, 0], [3, 0], [3, 2.5], [0, 2.5]], "closed": true,
      "thickness_m": 0.25, "material": "brick_red",
      "openings": [
        { "segment": 3, "at_m": 1.25, "width_m": 1.6, "sill_m": 0.9, "height_m": 1.0, "kind": "window" },
        { "segment": 2, "at_m": 1.0, "width_m": 0.9, "height_m": 2.0, "kind": "door", "leaf": { "door": "flush", "hinge": "end", "swing": "left", "start": "random" } }
      ]
    }
  ],
  "roof": { "rect_m": [-0.3, -0.3, 3.3, 2.8], "material": "roof_felt", "ceilingMaterial": "wood_planks" },
  "props": [ { "prop": "desk", "position_m": [1.0, 0, 1.0], "yaw_deg": -90 } ],
  "areas": [ { "name": "the weighbridge hut", "rect_m": [0, 0, 3, 2.5], "maxY_m": 2.6, "indoor": true, "light": 0.4 } ]
}
