// Plant room: 12 × 10 m of brick, 5 m high, where the cold store's refrigeration ran: three dead compressors in a row,
// the control desk, double doors onto the yard and a side door towards the store. The ammonia tanks stand outside.
// Wall segments: 0 north (x 0→12), 1 east (z 0→10), 2 south (x 12→0, at_m = 12 − x), 3 west (z 10→0, at_m = 10 − z).
{
  "id": "plant_room",
  "displayName": "Plant room",
  "storeys_m": [5.0],
  "slabThickness_m": 0.2,
  "footprint_m": [0, 0, 12, 10],
  "floorMaterial": "concrete_floor",
  "frames": "steel_painted",
  "gutters": "steel_rust",
  "fittings": "steel_painted",
  "trusses": { "material": "steel_rust", "spacing_m": 3.0, "depth_m": 0.5, "lampsPerTruss": 1 },
  "markings": {
    "color": "#d4aa2c",
    "lineWidth_m": 0.1,
    // A walkway marked round the compressors, and the room's name over the double doors.
    "lines_m": [[0.6, 5.2, 11.4, 5.2]],
    "stencils": [ { "text": "PLANT ROOM", "at_m": [6, 3.0, 10.16], "size_m": 0.35, "wall": true, "color": "#e4e0d4" } ]
  },
  "walls": [
    {
      "storey": 0, "points_m": [[0, 0], [12, 0], [12, 10], [0, 10]], "closed": true,
      "thickness_m": 0.3, "material": "brick_red",
      "openings": [
        { "segment": 0, "at_m": 3, "width_m": 2.0, "sill_m": 3.0, "height_m": 1.2, "kind": "window" },
        { "segment": 0, "at_m": 9, "width_m": 2.0, "sill_m": 3.0, "height_m": 1.2, "kind": "window" },
        { "segment": 1, "at_m": 3, "width_m": 1.6, "sill_m": 3.0, "height_m": 1.2, "kind": "window" },
        { "segment": 1, "at_m": 8, "width_m": 1.0, "height_m": 2.1, "kind": "door", "leaf": { "door": "steel", "hinge": "end", "swing": "left", "start": "random" } },
        { "segment": 2, "at_m": 6, "width_m": 2.0, "height_m": 2.4, "kind": "door", "leaf": { "door": "steel", "hinge": "start", "swing": "left", "double": true, "start": "random" } },
        { "segment": 2, "at_m": 10, "width_m": 1.6, "sill_m": 3.0, "height_m": 1.2, "kind": "window" },
        { "segment": 3, "at_m": 7, "width_m": 1.0, "height_m": 2.1, "kind": "door", "leaf": { "door": "steel", "hinge": "end", "swing": "left" } },
        { "segment": 3, "at_m": 3, "width_m": 1.6, "sill_m": 3.0, "height_m": 1.2, "kind": "window" }
      ]
    }
  ],
  "roof": { "rect_m": [-0.3, -0.3, 12.3, 10.3], "material": "corrugated_rust" },
  "props": [
    { "prop": "compressor", "position_m": [2.2, 0, 2.6], "yaw_deg": 90 },
    { "prop": "compressor", "position_m": [6.0, 0, 2.6], "yaw_deg": 90 },
    { "prop": "compressor", "position_m": [9.8, 0, 2.6], "yaw_deg": 90 },
    { "prop": "desk", "position_m": [9.6, 0, 8.6], "yaw_deg": 180 },
    { "prop": "filing_cabinet", "position_m": [11.5, 0, 6.6], "yaw_deg": -90 },
    { "prop": "oil_drum", "position_m": [0.7, 0, 9.2] },
    { "prop": "oil_drum_rust", "position_m": [1.3, 0, 9.4] },
    { "prop": "cable_reel", "position_m": [4.0, 0, 8.2], "yaw_deg": 25 }
  ],
  "areas": [ { "name": "the plant room", "rect_m": [0, 0, 12, 10], "maxY_m": 5.0, "indoor": true, "light": 0.3, "tone": "drip" } ]
