    { "prop": "crate_large", "position_m": [12, 1.2, 10.8] },
    { "prop": "crate_small", "position_m": [13.3, 1.2, 10.9] },
    { "prop": "forklift", "position_m": [18, 1.2, 9.0], "yaw_deg": -70 },
    { "prop": "pallet_stack_tall", "position_m": [24, 1.2, 10.5] },
    { "prop": "oil_drum", "position_m": [27.5, 1.2, 11.2] },
    { "prop": "crate_large", "position_m": [9, 1.2, 7.3] }
  ],
  "areas": [
    { "name": "goods shed", "rect_m": [0, 0, 30, 6], "maxY_m": 5.8, "indoor": true, "light": 0.5 },
    { "name": "the goods platform", "rect_m": [0, 6, 30, 12], "minY_m": 0.9, "maxY_m": 5.8, "indoor": true, "light": 0.55 }
  ]
