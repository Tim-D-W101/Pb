// The level kit: everything levels are built from. Paths are relative to the data folder.
// Buildings are templates in their own frame; a level places each one with a position and yaw.
{
  "materials": "kit/materials.jsonc",
  "props": "kit/props.jsonc",
  "doors": "kit/doors.jsonc",
  "buildings": [
    "kit/buildings/guardhouse.jsonc",
    "kit/buildings/pump_house.jsonc",
    "kit/buildings/office_block.jsonc",
    "kit/buildings/warehouse.jsonc",
    "kit/buildings/engine_shed.jsonc",
    "kit/buildings/goods_shed.jsonc",
    "kit/buildings/signal_box.jsonc",
    "kit/buildings/yard_office.jsonc",
    "kit/buildings/footbridge.jsonc",
    "kit/buildings/lamp_hut.jsonc",
    "kit/buildings/cold_store.jsonc",
    "kit/buildings/plant_room.jsonc",
    "kit/buildings/depot_office.jsonc",
    "kit/buildings/gatehouse.jsonc",
    "kit/buildings/weighbridge_hut.jsonc",
    "kit/buildings/north_wing.jsonc",
    "kit/buildings/west_wing.jsonc",
    "kit/buildings/boiler_house.jsonc",
    "kit/buildings/ambulance_canopy.jsonc",
    "kit/buildings/changing_room.jsonc"
  ]
}
