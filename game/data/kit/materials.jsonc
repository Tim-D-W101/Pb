// Surface materials for level geometry and props.
//   surface    paint physics row in break_model.jsonc (the only gameplay key here)
//   color      base colour (sRGB) for the procedural look
//   pattern    procedural pattern the shader draws until a texture is supplied:
//              plain, concrete, block, brick, plaster, corrugated, metal, rust, asphalt, dirt,
//              gravel, wood, tarp, rubber, glass, grass
//   tile_m     how many metres one repeat of the pattern or texture covers
//   roughness  0 = mirror, 1 = fully matte
//   weathering 0..1: grime at the foot of walls, stains, moss
// Optional: metallic (0..1), alpha (glass), albedo / normal / roughnessMap (res:// texture paths),
//   tint (sRGB colour multiplied with the albedo texture, so one photo serves several materials),
//   breakUpRepeat (true: shuffle the texture in patches a few metres across so its repeat doesn't
//   show as a grid; only for surfaces without a regular pattern, or bricks and planks come apart).
{
  "materials": [
    // Ground
    { "id": "asphalt_cracked", "surface": "asphalt", "color": "#4d4b47", "pattern": "asphalt", "tile_m": 2.5, "roughness": 0.92, "weathering": 0.6, "albedo": "res://art/textures/asphalt_cracked_albedo.jpg", "normal": "res://art/textures/asphalt_cracked_normal.jpg", "roughnessMap": "res://art/textures/asphalt_cracked_roughness.jpg", "breakUpRepeat": true },
    { "id": "dirt", "surface": "dirt", "color": "#6b5a45", "pattern": "dirt", "tile_m": 3.0, "roughness": 0.98, "weathering": 0.3, "albedo": "res://art/textures/dirt_albedo.jpg", "normal": "res://art/textures/dirt_normal.jpg", "roughnessMap": "res://art/textures/dirt_roughness.jpg", "breakUpRepeat": true },
    { "id": "gravel", "surface": "gravel", "color": "#7b766b", "pattern": "gravel", "tile_m": 2.0, "roughness": 0.95, "weathering": 0.3, "albedo": "res://art/textures/gravel_albedo.jpg", "normal": "res://art/textures/gravel_normal.jpg", "roughnessMap": "res://art/textures/gravel_roughness.jpg", "breakUpRepeat": true },
    { "id": "grass_dry", "surface": "turf", "color": "#6c7046", "pattern": "grass", "tile_m": 3.0, "roughness": 0.98, "weathering": 0.2, "albedo": "res://art/textures/grass_dry_albedo.jpg", "normal": "res://art/textures/grass_dry_normal.jpg", "roughnessMap": "res://art/textures/grass_dry_roughness.jpg", "breakUpRepeat": true },

    // Walls and floors
    { "id": "concrete_wall", "surface": "concrete", "color": "#9a978f", "pattern": "concrete", "tile_m": 2.5, "roughness": 0.90, "weathering": 0.70, "albedo": "res://art/textures/concrete_wall_albedo.jpg", "normal": "res://art/textures/concrete_wall_normal.jpg", "roughnessMap": "res://art/textures/concrete_wall_roughness.jpg", "breakUpRepeat": true },
    { "id": "concrete_floor", "surface": "concrete", "color": "#86837b", "pattern": "concrete", "tile_m": 3.0, "roughness": 0.85, "weathering": 0.60, "albedo": "res://art/textures/concrete_floor_albedo.jpg", "normal": "res://art/textures/concrete_floor_normal.jpg", "roughnessMap": "res://art/textures/concrete_floor_roughness.jpg", "breakUpRepeat": true },
