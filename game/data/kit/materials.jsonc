// Surface materials for level geometry and props.
//   surface    paint physics row in break_model.jsonc (the only gameplay key here)
//   color      base colour (sRGB) for the procedural look
//   pattern    procedural pattern the shader draws until a texture is supplied:
//              plain, concrete, block, brick, plaster, corrugated, metal, rust, asphalt, dirt,
//              gravel, wood, tarp, rubber, glass, grass
//   tile_m     how many metres one repeat of the pattern or texture covers
//   roughness  0 = mirror, 1 = fully matte
//   weathering 0..1: grime at the foot of walls, stains, moss
// Optional: metallic (0..1), alpha (glass), albedo / normal / roughnessMap (res:// texture paths).
{
  "materials": [
    // Ground
    { "id": "asphalt_cracked", "surface": "asphalt", "color": "#4d4b47", "pattern": "asphalt", "tile_m": 4.0, "roughness": 0.92, "weathering": 0.6 },
    { "id": "dirt", "surface": "dirt", "color": "#6b5a45", "pattern": "dirt", "tile_m": 3.0, "roughness": 0.98, "weathering": 0.3 },
    { "id": "gravel", "surface": "gravel", "color": "#7b766b", "pattern": "gravel", "tile_m": 2.0, "roughness": 0.95, "weathering": 0.3 },
    { "id": "grass_dry", "surface": "turf", "color": "#6c7046", "pattern": "grass", "tile_m": 3.0, "roughness": 0.98, "weathering": 0.2 },

    // Walls and floors
    { "id": "concrete_wall", "surface": "concrete", "color": "#9a978f", "pattern": "concrete", "tile_m": 2.5, "roughness": 0.90, "weathering": 0.70 },
    { "id": "concrete_floor", "surface": "concrete", "color": "#86837b", "pattern": "concrete", "tile_m": 3.0, "roughness": 0.85, "weathering": 0.60 },
    { "id": "concrete_block", "surface": "concrete", "color": "#8f8c85", "pattern": "block", "tile_m": 1.2, "roughness": 0.90, "weathering": 0.70 },
    { "id": "brick_red", "surface": "brick", "color": "#7f4b3b", "pattern": "brick", "tile_m": 1.0, "roughness": 0.90, "weathering": 0.60 },
    { "id": "brick_painted", "surface": "brick", "color": "#a9a49a", "pattern": "brick", "tile_m": 1.0, "roughness": 0.85, "weathering": 0.75 },
    { "id": "plaster_peeling", "surface": "plaster", "color": "#b8b09f", "pattern": "plaster", "tile_m": 2.0, "roughness": 0.90, "weathering": 0.80 },
    { "id": "roof_felt", "surface": "asphalt", "color": "#3c3b39", "pattern": "asphalt", "tile_m": 2.0, "roughness": 0.95, "weathering": 0.50 },

    // Metal
    { "id": "corrugated_rust", "surface": "metal", "color": "#7d7468", "pattern": "corrugated", "tile_m": 1.5, "roughness": 0.75, "weathering": 0.85, "metallic": 0.35 },
    { "id": "corrugated_grey", "surface": "metal", "color": "#8a9096", "pattern": "corrugated", "tile_m": 1.5, "roughness": 0.60, "weathering": 0.60, "metallic": 0.6 },
    { "id": "steel_painted", "surface": "metal", "color": "#4f5a52", "pattern": "metal", "tile_m": 1.0, "roughness": 0.55, "weathering": 0.50, "metallic": 0.5 },
    { "id": "steel_rust", "surface": "metal", "color": "#6e4a33", "pattern": "rust", "tile_m": 1.0, "roughness": 0.80, "weathering": 0.80, "metallic": 0.3 },
    { "id": "steel_yellow", "surface": "metal", "color": "#a08a2e", "pattern": "metal", "tile_m": 1.0, "roughness": 0.55, "weathering": 0.60, "metallic": 0.4 },
    { "id": "machinery", "surface": "metal", "color": "#4a5a5e", "pattern": "metal", "tile_m": 1.0, "roughness": 0.60, "weathering": 0.70, "metallic": 0.5 },
    { "id": "car_body", "surface": "metal", "color": "#5b5d5c", "pattern": "rust", "tile_m": 1.2, "roughness": 0.70, "weathering": 0.80, "metallic": 0.3 },
    { "id": "container_red", "surface": "metal", "color": "#8b3b2d", "pattern": "corrugated", "tile_m": 0.6, "roughness": 0.65, "weathering": 0.60, "metallic": 0.4 },
    { "id": "container_blue", "surface": "metal", "color": "#2f4f6b", "pattern": "corrugated", "tile_m": 0.6, "roughness": 0.65, "weathering": 0.60, "metallic": 0.4 },
    { "id": "container_green", "surface": "metal", "color": "#3f5a3c", "pattern": "corrugated", "tile_m": 0.6, "roughness": 0.65, "weathering": 0.60, "metallic": 0.4 },
    { "id": "drum_blue", "surface": "metal", "color": "#2c4a73", "pattern": "metal", "tile_m": 1.0, "roughness": 0.50, "weathering": 0.60, "metallic": 0.5 },
