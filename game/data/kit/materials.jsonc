    { "id": "steel_rust", "surface": "metal", "color": "#6e4a33", "pattern": "rust", "tile_m": 1.0, "roughness": 0.80, "weathering": 0.80, "metallic": 0.3, "albedo": "res://art/textures/steel_rust_albedo.jpg", "normal": "res://art/textures/steel_rust_normal.jpg", "roughnessMap": "res://art/textures/steel_rust_roughness.jpg", "breakUpRepeat": true },
