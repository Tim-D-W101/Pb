    // Soft stuff
    { "id": "wood_planks", "surface": "wood", "color": "#896a4b", "pattern": "wood", "tile_m": 1.0, "roughness": 0.85, "weathering": 0.60 },
    { "id": "wood_pallet", "surface": "wood", "color": "#a1845d", "pattern": "wood", "tile_m": 0.8, "roughness": 0.90, "weathering": 0.50 },
    { "id": "tyre_rubber", "surface": "rubber", "color": "#202020", "pattern": "rubber", "tile_m": 0.5, "roughness": 0.95, "weathering": 0.40 },
    { "id": "tarp_green", "surface": "tarp", "color": "#3d4a33", "pattern": "tarp", "tile_m": 1.5, "roughness": 0.90, "weathering": 0.50 },
    { "id": "sandbag", "surface": "tarp", "color": "#8c7b5c", "pattern": "tarp", "tile_m": 0.6, "roughness": 0.95, "weathering": 0.40 },
    { "id": "glass_dirty", "surface": "glass", "color": "#9fb0b0", "pattern": "glass", "tile_m": 1.0, "roughness": 0.15, "weathering": 0.60, "alpha": 0.35 }
  ]
}
