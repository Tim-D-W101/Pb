// Prop types. A prop's frame has its origin on the ground at the centre of its footprint and faces −Z.
// `colliders` are what paint and walking hit (boxes and cylinders, in metres); they are drawn as
// greybox geometry until a 3D `model` is supplied, and stay the gameplay shape afterwards.
//   box:      center_m, size_m [x, y, z]
//   cylinder: center_m, radius_m, height_m (axis = +Y, tilt with rotation_deg)
//   rotation_deg [about X, about Y, about Z]; walk: false lets characters pass (paint still hits)
// Props at least 0.9 m tall count as cover for bots unless "cover": false.
{
  "props": [
    {
      "id": "oil_drum", "displayName": "Oil drum",
      "colliders": [ { "shape": "cylinder", "center_m": [0, 0.44, 0], "radius_m": 0.29, "height_m": 0.88, "material": "drum_blue" } ]
    },
