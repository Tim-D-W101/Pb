// How things look and feel (not gameplay). Player-changeable values here are only defaults;
// changes made in game are saved to user://settings.json.
{
  // Team colours, by team: paint, armbands, top-bar icons and names. You're always the first. Solo and
  // teams use the first two (orange vs blue, a colourblind-safe pair); in free-for-all every player is a
  // team of their own with their own paint colour, so a ten-player round needs ten.
  "teamColors": ["#ff6a1a", "#2f8cff", "#3fd14a", "#e83fd0", "#ffd21a", "#19d3c5", "#e6332a", "#9d6bff", "#ff8fc8", "#f2f2ea"],

  "ball": {
    // A 17.3 mm ball is under 1 px beyond ~17 m at 1080p / 90° FOV. Balls are drawn at least this
    // many pixels wide so incoming paint stays readable. Cosmetic only: hits use the true size.
    "minPixels": 3.0,
    // Faint motion streak: the trailing half is stretched by speed × this time.
    "streak_s": 0.004,
    // Your own balls start at the drawn barrel and blend into their true path over this time.
    "visualBlend_s": 0.12
  },

  "splat": {
    // Decal pool cap (spec: 2,000). When full, the oldest `fadeWindow` splats fade out first.
    "cap": 2000,
    "fadeWindow": 64,
    "sizeMin_m": 0.14,
    "sizeMax_m": 0.26,
    "depth_m": 0.14,
    "normalFade": 0.35,
    "distanceFadeBegin_m": 70,
    "distanceFadeLength_m": 25
  },

  // Impact bursts. Bursts nearer the camera than minCameraDistance_m are skipped: point-blank spray
  // would fill the screen with flecks (paint on your mask is a separate effect).
  "fx": { "maxBurstsPerFrame": 12, "breakParticles": 14, "bounceParticles": 5, "minCameraDistance_m": 1.0 },

  "camera": {
    // Horizontal field of view at 16:9 (spec: default 90°, adjustable 70–110°). Wider screens see more.
    "fov_deg": 90,
    "fovMin_deg": 70,
    "fovMax_deg": 110,
    "fovStep_deg": 5,
    "nearClip_m": 0.03,
    // Far enough to reach the edge of the scrubland around a level, where fog has swallowed it.
    "farClip_m": 1500,
    // How much of the body's lean the view rolls with (0 = the horizon stays level, 1 = full lean).
    "leanRoll": 0.5,
    // Minimal head-bob (spec §1.5).
    "headBob": true,
    "headBobAmplitude_m": 0.01,
    "headBobStride_m": 1.8
  },

  "viewModel": {
    // The marker is drawn with its own vertical FOV so it looks the same at any FOV setting
    // and never clips into a bunker you hug.
    "fov_deg": 62,
    // Marker position in camera space: [right, up, forward].
    "offset_m": [0.23, -0.23, 0.52],
    // Tilt [pitch up, yaw left, roll] in degrees: angles the barrel slightly toward the crosshair.
    "rotation_deg": [1.5, 3.0, 0.0],
    // Barrel tip relative to the marker: [right, up, forward].
    "muzzleTip_m": [0.0, 0.02, 0.43],
    "kickBack_m": 0.012,
    "kickRecover_s": 0.08,
    // Your gloved hands on the grips (coyote brown, so they read against the black marker) and your
    // sleeves, running back out of view.
    "gloveColor": "#5e5444",
    "sleeveColor": "#39412f"
  },

  "look": {
    "mouseSensitivity_degPerCount": 0.06,
    "sensitivityStep": 0.005,
    "stickSpeed_degps": 220,
    "stickExponent": 1.6,
    "invertY": false
  },

  "crosshair": { "enabled": true, "size_px": 6, "gap_px": 4, "thickness_px": 2, "color": "#f2f2f2" },

  // Debug arc (F2): predicted path and drop at these distances.
  "arcPreview": { "enabledOnStart": false, "maxTime_s": 4.0, "probes_m": [10, 20, 30, 40] },

  // Graphics presets, cheapest first; F12 cycles them. Measured over the compound's viewpoints, relative
  // to Low: Medium costs about 1.2× (glow, more weeds and shadow reach), High 2.3× (ambient occlusion,
  // the biggest single cost, plus sunbeams, dust, window lights, sharper shadows and SMAA), and Ultra
  // adds bounced light (SDFGI), volumetric fog and reflections. Medium targets 60 fps at 1080p on
  // modest hardware; the render scale (below) buys more. The player's choice is saved in
  // user://settings.json.
  // Antialiasing is screen-space (screenAa: none, fxaa or smaa): with MSAA on, shaders can't read the
  // depth buffer the sunbeams need to stop at walls, so the beams switch off.
  // Per preset, the compound's lighting extras: the share of weeds drawn and how far (weedDensity,
  // weedDistance_m), sunbeam strength (lightShafts, 0 = off), dust motes in the beams, window fill
  // lights, the things lying on the ground (groundDetail) and old paint (oldPaint), both off on Low. Ultra's volumetric fog
  // already shows real beams and SDFGI bounces light, so it tones the fake beams down and drops the
  // fill lights.
  "graphics": {
    "defaultPreset": "medium",
    // V-sync on by default: no tearing, and frames paced to the monitor. F8 (or the pause menu) turns
    // it off, to see the uncapped frame rate.
    "vsync": true,
    // Render scale choices (settings): the 3D view is drawn at this share of the screen's resolution
    // and upscaled with AMD FSR 1.0, sharpened by fsrSharpness (0 = sharpest). The HUD stays sharp.
    // The first is the default.
    "renderScales": [1.0, 0.85, 0.75, 0.67, 0.5],
    "fsrSharpness": 0.2,
    "presets": [
      { "name": "low", "ssao": false, "ssil": false, "sdfgi": false, "volumetricFog": false, "ssr": false, "glow": false,
        "ambientProbes": true, "shadowSize": 2048, "shadowDistance_m": 60, "msaa": 0, "screenAa": "fxaa",
        "weedDensity": 0.35, "weedDistance_m": 28, "lightShafts": 0, "dust": false, "windowLights": false, "groundDetail": false, "oldPaint": false },
      { "name": "medium", "ssao": false, "ssil": false, "sdfgi": false, "volumetricFog": false, "ssr": false, "glow": true,
        "ambientProbes": true, "shadowSize": 2048, "shadowDistance_m": 75, "msaa": 0, "screenAa": "fxaa",
        "weedDensity": 0.5, "weedDistance_m": 35, "lightShafts": 0, "dust": false, "windowLights": false, "groundDetail": true, "oldPaint": true },
      { "name": "high", "ssao": true, "ssil": false, "sdfgi": false, "volumetricFog": false, "ssr": false, "glow": true,
        "ambientProbes": true, "shadowSize": 4096, "shadowDistance_m": 90, "msaa": 0, "screenAa": "smaa",
        "weedDensity": 0.75, "weedDistance_m": 45, "lightShafts": 1.0, "dust": true, "windowLights": true, "groundDetail": true, "oldPaint": true },
      { "name": "ultra", "ssao": true, "ssil": true, "sdfgi": true, "volumetricFog": true, "ssr": true, "glow": true,
        "ambientProbes": true, "shadowSize": 4096, "shadowDistance_m": 130, "msaa": 0, "screenAa": "smaa",
        "weedDensity": 1.0, "weedDistance_m": 70, "lightShafts": 0.6, "dust": true, "windowLights": false, "groundDetail": true, "oldPaint": true }
    ]
  },

  // Compound lighting: a low, warm late-afternoon sun in the west-south-west through broken overcast.
  // Overcast means soft shadows that aren't black: a modest sun and plenty of sky light.
  "lighting": {
    "sunElevation_deg": 21,
    "sunAzimuth_deg": 245,
    "sunColor": "#ffd6ad",
    "sunEnergy": 1.25,
    // Blur of the sun's shadow edges (Godot's shadow_blur; 1 = default, higher = softer).
    "sunShadowBlur": 2.5,
    "skyTopColor": "#5d6878",
    "skyHorizonColor": "#bdb8ad",
    "groundColor": "#4a443b",
    "cloudCover": 0.75,
    "ambientEnergy": 0.85,
    // Distant ground fades into this colour; the sky below the horizon uses it too, so the edge of
    // the world never shows.
    "fogColor": "#a8a59c",
    "fogDensity": 0.0028,
    "exposure": 1.0,
    // A deck of cloud drifting over (looks only): its height, the size of its noise tile on it (bigger
    // makes bigger clouds), the wind moving it ([x, z] m/s: +x east, +z south), how opaque the
    // thickest cloud is, its sunlit and shaded colours, and how much of the sky's own still cloud
    // stays showing behind it as a high layer (0-1). cloudCover above sets how much sky it covers.
    "clouds": {
      "height_m": 1400,
      "tile_m": 7000,
      "wind_mps": [9, -4],
      "opacity": 0.95,
      "litColor": "#eee6da",
      "shadeColor": "#7e828b",
      "highLayer": 0.45
    }
  },

  // Distant tree lines around compound levels, so the horizon reads as land rather than a ruler-
  // straight edge. Each ring is a jagged silhouette with gaps of open country; fog fades it into
  // the sky. Keep the rings inside camera.farClip_m.
  "horizon": {
    "color": "#3b4232",
    "rings": [
      { "radius_m": 340, "minHeight_m": 6, "maxHeight_m": 17, "gaps": 0.3 },
      { "radius_m": 680, "minHeight_m": 12, "maxHeight_m": 34, "gaps": 0.15 }
    ],
    // A town's edge far off, grey in the haze: chimneys and sawtooth sheds to the north-east, a
    // gasholder's frame to the north-west, flats to the south-west. Bearing: 0 north, 90 east.
    "landmarkColor": "#3c3e3e",
    "landmarks": [
      { "kind": "chimney", "bearing_deg": 34, "distance_m": 520, "height_m": 55, "width_m": 4.5 },
      { "kind": "chimney", "bearing_deg": 40, "distance_m": 545, "height_m": 41, "width_m": 3.6 },
      { "kind": "shed", "bearing_deg": 28, "distance_m": 470, "height_m": 15, "width_m": 70 },
      { "kind": "shed", "bearing_deg": 46, "distance_m": 500, "height_m": 13, "width_m": 50 },
      { "kind": "gasholder", "bearing_deg": 302, "distance_m": 430, "height_m": 32, "width_m": 44 },
      { "kind": "flats", "bearing_deg": 208, "distance_m": 600, "height_m": 38, "width_m": 22 },
      { "kind": "flats", "bearing_deg": 221, "distance_m": 640, "height_m": 30, "width_m": 26 }
    ]
  },

  // Weeds and dry grass wherever rain falls (nothing overhead): thick on scrubland, patchy on dirt and
  // gravel, in a network of cracks on asphalt and concrete, and along the foot of walls and props.
  // Seeded by the level id, so they're the same every run. Presentation only: paint passes through.
  "weeds": {
    // Tufts per square metre by ground material id; materials not listed grow none. On the crack
    // materials the density applies along the cracks only.
    "density_perM2": { "grass_dry": 5.0, "dirt": 0.7, "gravel": 0.45, "asphalt_cracked": 3.0, "concrete_floor": 2.0 },
    "grassMaterials": ["grass_dry"],
    "crackMaterials": ["asphalt_cracked", "concrete_floor"],
    "crackSpacing_m": 3.5,
    "crackWidth_m": 0.22,
    // Along the foot of walls, columns and props: tufts per metre of edge, growing within this reach.
    "edgeDensity_perM": 2.2,
    "edgeReach_m": 0.3,
    // Weeds grow in patches about this big, with about this share of the ground left bare.
    "clumpSize_m": 7,
    "bare": 0.3,
    "heightMin_m": 0.12,
    "heightMax_m": 0.55,
    // A tuft's width as a multiple of its height.
    "width": 1.25,
    // Tints, from straw to olive (multiplied with the painted tuft).
    "colors": ["#f0e2b8", "#e2d6a6", "#cfd09a", "#bcc48c", "#e8cfa0"],
    // How far tips sway, how fast, and the size of the gusts that roll across.
    "windSway_m": 0.05,
    "windSpeed": 1.4,
    "gustSize_m": 12,
    // Nothing grows this close to a pickup, so grass never hides a pod.
    "pickupClearance_m": 0.9,
    // Tufts are grouped in squares this big, which are culled as a whole.
    "chunkSize_m": 16
  },

  // Things lying on the ground: oil stains round the car and the machines, puddles under the open sky,
  // damp patches, rust run-off by rusting things, tyre tracks, drifts of leaves against walls, litter
  // and broken chips. Painted at load into one atlas and drawn as flat cards in one draw call; seeded
  // by the level id, so they're the same every run. Presentation only. Each kind: how many, the length
  // of a card (smallest, largest), width as a share of length ("aspect"), the ground materials it lies
  // on, "sky" (open, covered or any), props it gathers round with the share placed there ("near",
  // "nearShare"), the share along the foot of walls ("edgeShare"), and how opaque it is.
  "groundDetail": {
    "fadeStart_m": 40,
    "fadeEnd_m": 65,
    "kinds": [
      { "kind": "damp", "count": 80, "size_m": [1.6, 4.5], "on": ["asphalt_cracked", "dirt", "gravel", "concrete_floor"], "opacity": 0.85 },
      { "kind": "puddle", "count": 45, "size_m": [1.0, 3.2], "on": ["asphalt_cracked", "dirt"], "sky": "open" },
      { "kind": "oil", "count": 140, "size_m": [0.5, 1.8], "on": ["asphalt_cracked", "concrete_floor", "gravel"],
        "near": ["car_wreck", "generator", "forklift", "pump_unit", "oil_drum", "oil_drum_rust", "oil_drum_tipped", "skip_bin"], "nearShare": 0.6 },
      { "kind": "rust", "count": 70, "size_m": [0.6, 1.8], "on": ["asphalt_cracked", "dirt", "gravel", "concrete_floor"],
        "near": ["oil_drum_rust", "oil_drum_tipped", "scrap_pile", "skip_bin", "car_wreck", "water_tower", "container_red", "container_blue", "container_green", "shelving_rack"], "nearShare": 1.0 },
      { "kind": "tracks", "count": 20, "size_m": [4, 6], "aspect": 0.45, "on": ["asphalt_cracked", "dirt"], "sky": "open", "opacity": 0.85 },
      { "kind": "leaves", "count": 160, "size_m": [0.6, 1.3], "on": ["asphalt_cracked", "dirt", "gravel", "concrete_floor"], "edgeShare": 0.8 },
      { "kind": "litter", "count": 140, "size_m": [0.5, 1.0], "on": ["asphalt_cracked", "dirt", "gravel", "concrete_floor"], "edgeShare": 0.4 },
      { "kind": "chips", "count": 110, "size_m": [0.6, 1.4], "on": ["asphalt_cracked", "dirt", "gravel", "concrete_floor"],
        "near": ["rubble_pile", "scrap_pile"], "nearShare": 0.5, "edgeShare": 0.35 }
    ]
  },

  // Old paint from games played here before: faded splats where people shooting from one cover spot at
  // another would have hit, on the cover and walls and on the ground short of them. Shots are cast at
  // load from the bots' cover points at others facing them across their cover, straying by about
  // spread_m; seeded by the level id. A card is placed only where it lies flat on what it hit. Drawn
  // in one draw call; presentation only.
  // Behind the main menu: this level, seen from a camera drifting from one point to the other and
  // back over period_s (vertical fov_deg), with the menu's wash darkest (shade) on the left where the
  // panels sit. Built at the saved graphics preset; nothing moves in it but the camera and the weeds.
  "menuBackdrop": {
    "level": "oxbarrow_works",
    "from": { "position_m": [9, 2.6, 24], "yaw_deg": 12, "pitch_deg": -4 },
    "to": { "position_m": [1, 2.3, 25], "yaw_deg": -2, "pitch_deg": -3 },
    "period_s": 80,
    "fov_deg": 55,
    "shade": 0.82
  },

  // The training ground (the Phase 1 range, scenes/Range.tscn), dressed with the level kit
  // (kit/materials.jsonc ids) under the levels' lighting and tree lines. Looks only: ranges/phase1.jsonc
  // decides what paint hits. The nets, backstop and boards also stop you walking through them.
  "trainingGround": {
    // The lane, its photo tinted a little greener than the scrub round it, and the gravel behind the
    // firing line where you stand; the paint of the lines across the lane and of the firing line.
    "field": "grass_dry",
    "fieldTint": "#d9e3b6",
    "firingPoint": "gravel",
    "lineColor": "#e6e2d4",
    "firingLineColor": "#e0b22c",
    // Netting down both sides, on posts with a cable sagging along their tops. The netting is painted at
    // load: squares mesh_m across, the twine covering this share of each side, so far off it's a haze.
    "nets": {
      "height_m": 6.0,
      "postSpacing_m": 6.0,
      "postRadius_m": 0.045,
      "posts": "steel_galvanised",
      "color": "#20261f",
      "mesh_m": 0.05,
      "twine": 0.1,
      "sag_m": 0.14
    },
    // The far end: a wall of boards on posts, reaching overhang_m past each side of the lane, an earth
    // bank behind it with grass on top rising bankRise_m above it, and netting on poles up to netHeight_m.
    "backstop": {
      "boards": "wood_planks",
      "posts": "wood_planks",
      "bank": "dirt",
      "bankTop": "grass_dry",
      "height_m": 3.4,
      "bankRise_m": 0.9,
      "bankDepth_m": 7.0,
      "netHeight_m": 9.0,
      "overhang_m": 6.0
    },
    // Distance boards on posts down the left of the lane, at the range's labelled distances: the nearest
    // width_m[0] across, the farthest width_m[1], so they read from the firing line.
    "boards": { "board": "enamel_white", "posts": "wood_planks", "textColor": "#232320", "width_m": [0.75, 2.2] },
    // A lean-to shelter behind the firing point, open to the lane: timber frame, corrugated roof falling
    // to the back, boarded back wall with a bench, a table with pods and a tank. position_m is its
    // middle [x, z] (the firing line is z = 0).
    "hut": { "position_m": [-8, 10.5], "width_m": 7.5, "depth_m": 3.0, "height_m": 2.7, "frame": "wood_planks", "roof": "corrugated_grey", "boards": "wood_pallet" },
    // The inflatable bunkers: this fabric in each prop's colour (ranges/phase1.jsonc), seams a shade
    // darker, tethered to pegs; thin board props are this board on stakes.
    "inflatable": "nylon",
    "tethers": "sandbag",
    "panel": "hardboard",
    "stakes": "wood_planks",
    // The target dummies: a padded body on a tyre filled with concrete (or a trolley on rails, if it
    // moves), a head in a mask. They flash this colour when hit.
    "dummy": {
      "body": "nylon", "bodyColor": "#e8e2d0", "straps": "plastic_black",
      "head": "nylon", "headColor": "#8d877c", "mask": "plastic_black", "lens": "glass_dirty",
      "base": "tyre_rubber", "fill": "concrete_floor",
      "flashColor": "#ff5a1a"
    },
    "rails": "steel_rust",
    "sleepers": "wood_planks",
    // Years of practice: shots from the firing line at the targets (landing round and behind them), the
    // bunkers and the backstop. Same keys as "oldPaint"; the props list doesn't apply here.
    "oldPaint": {
      "count": 900,
      "range_m": 120,
      "spread_m": 0.5,
      "size_m": [0.3, 0.9],
      "colors": ["#e8508e", "#f08a2a", "#e6c43a", "#7cc44a", "#3e8ee8", "#9a5ad6", "#ece8dc"],
      "fade": [0.05, 0.5],
      "opacity": [0.65, 0.95],
      "props": {},
      "fadeStart_m": 90,
      "fadeEnd_m": 140
    },
    // The same on each dummy, aimed at it: small splats, as a flat card has to lie on its round body.
    "dummyPaint": {
      "count": 45,
      "range_m": 120,
      "spread_m": 0.12,
      "size_m": [0.1, 0.26],
      "colors": ["#e8508e", "#f08a2a", "#e6c43a", "#7cc44a", "#3e8ee8", "#9a5ad6", "#ece8dc"],
      "fade": [0.05, 0.45],
      "opacity": [0.7, 0.95],
      "props": {},
      "fadeStart_m": 45,
      "fadeEnd_m": 75
    },
    // Out beyond it: a power line across the skyline past the backstop, telegraph poles down the track
    // to the right. Plan [x, z] with the firing line at z = 0 and the lane running to −z.
    "scenery": {
      "powerLines": [ { "points_m": [[-520, -330], [-90, -290], [520, -260]], "spacing_m": 230, "height_m": 28, "material": "steel_galvanised", "wire": "steel_painted" } ],
      "poleLines": [ { "points_m": [[44, 70], [48, -140], [60, -420]], "spacing_m": 42, "height_m": 8.5, "material": "wood_planks", "wire": "steel_painted" } ]
    }
  },

  // Soft contact shadows on the floor round the foot of walls and columns, and of props, where sky
  // light can't get in under them, on presets without ambient occlusion (looks only): how dark against
  // the footprint (0-1) and how far out they fade; pieces shorter than minHeight_m get none.
  "contactShadows": {
    "wallStrength": 0.45,
    "wallReach_m": 0.7,
    "propStrength": 0.55,
    "propReach_m": 0.5,
    "minHeight_m": 0.15,
    "fadeStart_m": 35,
    "fadeEnd_m": 60
  },

  // Debris on the floors indoors, on every storey (looks only): papers lying about or screwed up,
  // plaster fallen off the walls, dust drifting into corners, leaves blown in, and glass under the
  // broken windows on both sides. perSquareMetre is per square metre of each room's floor, edgeShare
  // the share of those along the foot of the walls; perWindow is how many under each window on each
  // side. Sizes are least-most metres; colours sRGB; gloss 0 matte to 1 like glass.
  "floorDebris": {
    "fadeStart_m": 30,
    "fadeEnd_m": 50,
    "kinds": [
      { "kind": "papers", "perSquareMetre": 0.12, "edgeShare": 0.35, "size_m": [0.3, 0.46], "color": "#dcd6c4" },
      { "kind": "plaster", "perSquareMetre": 0.08, "edgeShare": 0.85, "size_m": [0.4, 1.0], "color": "#cbc3ae" },
      { "kind": "dust", "perSquareMetre": 0.06, "edgeShare": 0.8, "size_m": [0.7, 1.6], "color": "#4f483d", "opacity": 0.85 },
      { "kind": "leaves", "perSquareMetre": 0.04, "edgeShare": 0.7, "size_m": [0.35, 0.7], "color": "#7a5530" },
      { "kind": "glass", "perWindow": 2.5, "size_m": [0.3, 0.7], "color": "#c8d4d0", "gloss": 1.0 }
    ]
  },

  // Run-off streaks down the outside walls (looks only): grime running from under the windows' sills,
  // rust from the fittings, downpipe collars and the wire's brackets, and stains scattered along the
  // gutters and copings. Colours are sRGB; rustFrom says how much rust each kit material sheds (0-1;
  // others shed grime). Lengths are least-most metres a streak runs (cut short above an opening below
  // it and at the ground); lineWidth_m and lineSpacing_m are for streaks along gutters and copings.
  "runOff": {
    "grime": "#2b2720",
    "rust": "#8a4317",
    "rustFrom": { "steel_rust": 1.0, "steel_painted": 0.55, "steel_galvanised": 0.35 },
    "chance": 0.85,
    "sillLength_m": [0.6, 1.8],
    "fittingLength_m": [0.7, 1.8],
    "lineLength_m": [1.0, 2.6],
    "lineWidth_m": [0.35, 1.1],
    "lineSpacing_m": [0.8, 2.6],
    "opacity": [0.55, 0.9],
    "fadeStart_m": 40,
    "fadeEnd_m": 65
  },

  // Cobwebs in the corners of the buildings' doorways (the top ones) and windows (looks only): the
  // chance a corner has one, how big, how see-through, their colour, and where they fade out.
  "cobwebs": {
    "chance": 0.4,
    "size_m": [0.18, 0.45],
    "opacity": [0.45, 0.8],
    "color": "#d9d7d0",
    "fadeStart_m": 18,
    "fadeEnd_m": 32
  },

  // Crows wheeling over each level and the training ground (looks only): each flock circles round a
  // point [x, z] from the place's middle, each bird on its own circle and height, gliding for a few
  // seconds (flapEvery_s) between bursts of wingbeats (flapFor_s). On a level a few more sit on the
  // wall tops and take off when you come close.
  "birds": {
    "flocks": [
      { "center_m": [-12, -18], "count": 6, "radius_m": [16, 34], "height_m": [26, 44] },
      { "center_m": [36, 24], "count": 3, "radius_m": [9, 18], "height_m": [16, 26] }
    ],
    "speed_mps": 8.5,
    "wingspan_m": 0.9,
    "color": "#1b1b1d",
    "flapEvery_s": [3, 9],
    "flapFor_s": [0.8, 2.2],
    // On a level, this many more sit on the tops of its walls, until you come this close.
    "perched": 9,
    "flushDistance_m": 9
  },

  // Worn paint on the buildings (each template's "markings": floor lines, hatched bays, stencilled
  // numbers, striped columns): how opaque the paint is that's left, and where it fades out.
  "markings": {
    "opacity": [0.55, 0.9],
    "fadeStart_m": 55,
    "fadeEnd_m": 85
  },

  // Ivy and dead vines climbing the outside walls: patches standing on the ground against walls of
  // these materials, under the open sky, each with wall behind it all the way up and across (none
  // climbs over a window or round a corner). Painted at load; seeded by the level id.
  "creepers": {
    "count": 110,
    "width_m": [0.9, 2.2],
    "height_m": [1.0, 3.6],
    "on": ["concrete_block", "concrete_wall", "brick_red", "brick_painted", "plaster_peeling"],
    "fadeStart_m": 45,
    "fadeEnd_m": 75
  },

  "oldPaint": {
    "count": 2400,
    "range_m": 40,
    "spread_m": 0.8,
    // A card's width; the splat's middle is about a third of it, its spray reaches the edges.
    "size_m": [0.4, 1.1],
    // Typical paint fills, before fading: pink, orange, yellow, green, blue, purple, white.
    "colors": ["#e8508e", "#f08a2a", "#e6c43a", "#7cc44a", "#3e8ee8", "#9a5ad6", "#ece8dc"],
    "fade": [0.1, 0.5],
    "opacity": [0.6, 0.95],
    // Props paint shows on, with how far each shape's faces sit inside its colliders (m). Walls,
    // columns and the ground always take paint; round or ragged props (drums, tyres, sandbags, the
    // car, heaps) don't, since a flat card would stand off them.
    "props": { "container_red": 0.022, "container_blue": 0.022, "container_green": 0.022, "crate_large": 0.025, "crate_small": 0.025 },
    "fadeStart_m": 40,
    "fadeEnd_m": 65
  },

  // Sunbeams through windows, doors and holes in the roof, wherever the sun reaches into a roofed
  // space. A beam is a box of light, ray-marched per pixel and cut off by whatever is in front of it.
  "shafts": {
    // Glow per metre of beam you look through (scaled by the preset's lightShafts), and how fast a
    // beam fades with distance from its opening.
    "density_perM": 0.035,
    "falloff_perM": 0.035,
    // A beam's soft edge at the opening, widening by this much per metre.
    "edgeSoftness_m": 0.18,
    "edgeSpread": 0.03,
    // Drifting dust breaks a beam up: how much (0 = even glow), the swirl size and drift speed.
    "patchiness": 0.55,
    "swirlSize_m": 1.4,
    "swirlSpeed_mps": 0.07,
    // Roof holes let in a broad sheet of light; their beams get this share of the glow.
    "roofHoleFactor": 0.45,
    "maxLength_m": 40,
    // Openings the sun strikes at less than this angle get no beam.
    "minSunAngle_deg": 4,
    // Glow this close to the camera fades out, so standing in a beam doesn't wash out the view.
    "nearFade_m": 2.5,
    // Beams ignore fog, so they fade out between these camera distances instead.
    "fadeStart_m": 45,
    "fadeEnd_m": 100,
    // Samples per pixel along the view ray through a beam.
    "samples": 6
  },

  // Dust motes drifting in the sunbeams. Only lit dust shows, so they live inside the beams.
  "dust": {
    "perCubicMetre": 5,
    "maxPerBeam": 400,
    "size_m": 0.008,
    "lifetime_s": 9,
    "drift_mps": 0.04,
    "brightness": 1.0
  },

  // Daylight spilling in, for presets without global illumination: an unshadowed spotlight just inside
  // each window or door (neighbours on one wall share one), and a warm bounce light where a sun patch
  // lands on the floor.
  "windowLight": {
    // Spotlight energy per square metre of opening (capped), colour, cone and reach.
    "energy_perM2": 0.12,
    "maxEnergy": 1.2,
    "color": "#c9d2dc",
    "angle_deg": 70,
    "range_m": 7,
    "mergeDistance_m": 3.5,
    // Bounce light per square metre of sunlit opening (capped), tint (times the sun's colour), reach.
    "bounceEnergy_perM2": 0.08,
    "maxBounceEnergy": 1.5,
    "bounceTint": "#d8c4a8",
    "bounceRange_m": 6
  },

  // Opponents are rigged models from the art pipeline, posed every frame to match the sim's hitbox
  // rig (stance, lean, aim, hands on the marker). A missing model falls back to drawing the hitboxes.
  "characters": {
    // Models, dealt to opponents in turn, and tints for their colours, so copies of one model differ.
    "models": ["res://art/models/opponent_a.glb"],
    "tints": ["#ffffff", "#c8ccd4", "#e8dcc0"],
    // The team-colour armband on each upper arm.
    "armbandRadius_m": 0.068,
    "armbandWidth_m": 0.09,
    // Movement clips, shared by every model (each a GLB holding one in-place clip on the generator's
    // rig, fitted to each model's build by bone name): "walk", "run" and "crouchWalk". Each plays at
    // the pace that keeps its feet planted; walk blends into run between the two clips' own speeds,
    // and into the crouched walk as you crouch, all in step. Any can be left out; without a walk, the
    // steps below stand in.
    "clips": {},
    // How long clips take to blend in and out, and between each other.
    "clipBlend_s": 0.2,
    // The legs turn from where you face towards where you're going, by up to this much (the chest
    // stays on the aim); backing off plays the cycle backwards.
    "maxLegYaw_deg": 65,
    // Steps while moving without a walk clip: stride, foot lift, the speed of a full stride and how
    // long steps take to reach it from a standstill, and how far the hips bob at each footfall.
    "stride_m": 0.75,
    "stepLift_m": 0.12,
    "fullStrideSpeed_mps": 3.0,
    "strideEase_s": 0.25,
    "hipBob_m": 0.025,
    // How far the hips drop for each metre the eye drops when crouching.
    "hipDropPerEyeDrop": 0.85,
    // Shares of the aim pitch the chest and the head take.
    "chestPitch": 0.3,
    "headPitch": 0.6,
    // Where the wrists sit on the marker: along it from the back (0) to the front (1), and below it.
    "triggerGrip": 0.3,
    "supportGrip": 0.85,
    "gripDrop_m": 0.03
  },

  // Paint on your mask when a ball breaks near your face (spec §1.3): drops of the ball's colour that
  // block part of the view and clear over duration_s.
  "maskSpray": { "duration_s": 2.5, "maxOpacity": 0.85, "drops": 6, "minSize": 0.12, "maxSize": 0.45 },

  // After you're eliminated, a view from above and behind where you stood, facing whoever got you,
  // for duration_s. Then, while your team (or, in free-for-all, anyone) is still in, a camera follows
  // one of them from followBack_m behind and followHeight_m above their eyes; click for the next.
  "spectator": { "duration_s": 4.0, "height_m": 1.4, "back_m": 2.5, "followBack_m": 3.2, "followHeight_m": 0.9 },

  // The match HUD (spec §6): top bar with the clock and an in/out icon per player, kill feed,
  // subtitles for what players shout, pickup prompts and a hit marker.
  "hud": {
    // Top bar icons, this size.
    "iconSize_px": 18,
    // Kill feed: newest on top, this many lines, each shown this long.
    "killFeedLines": 5,
    "killFeedTime_s": 6,
    // Subtitles for callouts ("Contact!", "Hit!"): shown this long, if the caller is within this
    // distance (about how far a shout carries in the compound).
    "subtitleTime_s": 2.5,
    "subtitleRange_m": 35,
    // A pickup within this distance gets a prompt under the crosshair.
    "pickupPromptRange_m": 4,
    // The crosshair flashes this marker when your ball puts someone out.
    "hitMarkerTime_s": 0.35,
    "hitMarkerColor": "#ffffff",
    // Opponents' callsigns, dealt in a shuffled order each round (invented names only).
    "callsigns": ["Rook", "Magpie", "Tinker", "Moth", "Ferret", "Badger", "Sparrow", "Flint", "Gannet", "Wren", "Otter", "Lark"],
    // What bots shout; one line is picked per call.
    "callouts": {
      "spotted": ["Contact!", "There!", "Eyes on one!", "Over here!"],
      "lost": ["Lost them.", "Where'd they go?", "Anyone see them?"],
      "underFire": ["Taking fire!", "Incoming!", "I'm pinned!"],
      "refill": ["Reloading!", "Changing pods!"],
      "hit": ["Hit!", "I'm hit!", "Hit, hit!"]
    }
  },

  "audio": {
    "voices": 24,
    "maxSoundsPerFrame": 6,
    "volume_db": -6,
    // The shot sound's pitch follows tank pressure (spec §8): empty tank → low, full → high.
    "shotPitchEmpty": 0.82,
    "shotPitchFull": 1.05,
    "maxDistance_m": 140
  }
}
