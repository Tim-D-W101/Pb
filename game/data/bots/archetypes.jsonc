// Bot behaviours (M2.5). An opponent spawn's roles (levels/*.jsonc) name the behaviour: the first
// role listed here wins.
//   idle            what they do while nothing's happening: "post" (hold the spawn and scan),
//                   "patrol" (walk the spawn's patrol route) or "hunt" (sweep the level's opponent
//                   spawns one by one); "speedball" plays a point on a field from the bunker it's dealt
//   leash_m         how far from home they'll go to fight or search before heading back
//   useCover        fight from cover (peek, shoot, duck back); rushers just come at you
//   peekTime_s      time exposed per peek, then hideTime_s back in cover
//   flankChance     per decision while you're out of sight: chance to work round to a new angle
//   pushChance      ... or to push straight at your last known position (both scaled by the tier's
//                   aggression, 0.5 = as written)
//   fireOnMove      shoots while walking or running (the marker can't fire while sprinting anyway)
//   engageRange_m   distance they like to fight from: cover is picked around it
//   searchTime_s    how long they hunt around a last known position before giving up
//   moveGait        how they move when it matters: "walk" or "run" (patrols are always walked)
// Optional (Phase 3):
//   idle "overwatch" takes the best vantage (a high, open view: brain.jsonc "vantage…") within overwatchReach_m
//                   of the spawn and watches from it
//   vantage         how much a high, open view counts when picking cover to fight from (0 = not at all)
//   steadyShots     beyond closeRange_m it only fires once its aim has settled on a still target
//   pullScale       scales the tier's time between trigger pulls (careful shooters above 1)
//   relocateAfterShots  after this many shots from one spot it moves to another 8 m or more away (0 = never);
//   relocateWhenShotAt  ... or as soon as balls land round it
//   flankOnContact  a teammate's call sends it round to the side, out of the enemy's sight, instead of straight at them
//   holdFireWhileFlanking  it doesn't shoot on the way to a flanking spot unless the enemy turns its way, comes within
//                   closeRange_m or shoots at it
//   stealthWithin_m it crouch-walks the last this-many metres to a flanking spot
{
  "archetypes": [
    {
      "id": "sentry",
      "idle": "post", "leash_m": 12, "useCover": true,
      "peekTime_s": 1.4, "hideTime_s": 1.2,
      "flankChance": 0.1, "pushChance": 0.05,
      "fireOnMove": false, "engageRange_m": 25, "searchTime_s": 10, "moveGait": "run"
    },
    {
      "id": "patroller",
      "idle": "patrol", "leash_m": 35, "useCover": true,
      "peekTime_s": 1.1, "hideTime_s": 1.0,
      "flankChance": 0.35, "pushChance": 0.2,
      "fireOnMove": false, "engageRange_m": 20, "searchTime_s": 16, "moveGait": "run"
    },
    {
      // Plays your slot in the headless bot match (CI): no spawn of its own, it goes looking.
      "id": "hunter",
      "idle": "hunt", "leash_m": 500, "useCover": true,
      "peekTime_s": 1.2, "hideTime_s": 1.0,
      "flankChance": 0.3, "pushChance": 0.35,
      "fireOnMove": false, "engageRange_m": 20, "searchTime_s": 12, "moveGait": "run"
    },
    {
      // Takes high ground with long views and shoots carefully from range, moving after a few shots.
      "id": "marksman",
      "idle": "overwatch", "leash_m": 10, "useCover": true,
      "peekTime_s": 2.0, "hideTime_s": 1.6,
      "flankChance": 0.0, "pushChance": 0.0,
      "fireOnMove": false, "engageRange_m": 40, "searchTime_s": 6, "moveGait": "run",
      "overwatchReach_m": 35, "vantage": 1.0, "steadyShots": true, "closeRange_m": 12, "pullScale": 1.8,
      "relocateAfterShots": 6, "relocateWhenShotAt": true
    },
    {
      // Works round out of sight to come at you from the side once a teammate has called you out.
      "id": "flanker",
      "idle": "patrol", "leash_m": 70, "useCover": true,
      "peekTime_s": 1.0, "hideTime_s": 0.9,
      "flankChance": 0.85, "pushChance": 0.1,
      "fireOnMove": false, "engageRange_m": 16, "searchTime_s": 14, "moveGait": "run",
      "flankOnContact": true, "holdFireWhileFlanking": true, "stealthWithin_m": 8, "closeRange_m": 9
    },
    {
      // Speedball: dealt a place (front, middle or back) and a bunker by the squad at every breakout, and plays the
      // point from there: quick snap shots out of it, moving up when its side is ahead.
      "id": "speedball",
      "idle": "speedball", "leash_m": 80, "useCover": true,
      "peekTime_s": 0.9, "hideTime_s": 0.8,
      "flankChance": 0.15, "pushChance": 0.1,
      "fireOnMove": false, "engageRange_m": 25, "searchTime_s": 6, "moveGait": "run"
    },
    {
      "id": "rusher",
      "idle": "post", "leash_m": 60, "useCover": false,
      "peekTime_s": 0.8, "hideTime_s": 0.5,
      "flankChance": 0.2, "pushChance": 0.85,
      "fireOnMove": true, "engageRange_m": 10, "searchTime_s": 22, "moveGait": "run"
    }
  ]
}
