// How every bot thinks and acts (M2.5), whatever its behaviour and difficulty: timings and
// distances for looking, investigating, fighting from cover, searching and walking off.
{
  // A sound or a glimpse: they stop and look that way this long before going to have a look.
  "suspiciousTime_s": 1.5,

  // Investigating: they walk, and crouch-walk once within this distance of the lead.
  "crouchNearLead_m": 6,

  // On spotting someone in the open they shoot from where they stand for up to this long before
  // taking cover, unless that someone is closer than openFireMinDistance_m (then they take cover now).
  "openFireTime_s": 1.2,
  "openFireMinDistance_m": 6,

  // Cover: looked for within this distance, never closer to the enemy than minThreatDistance_m.
  "coverSearchRadius_m": 18,
  "minThreatDistance_m": 5,

  // Peeking: exposed this long without seeing the enemy, they duck back early.
  "peekGiveUp_s": 0.9,

  // In a fight, out of sight this long counts as lost: they flank, push or hold (archetype chances).
  // Lost for giveUpTime_s, they go searching.
  "lostSightTime_s": 2.5,
  "giveUpTime_s": 9,

  // Searching: they visit up to searchHops spots within searchRadius_m of the last known position.
  "searchRadius_m": 8,
  "searchHops": 3,

  // Holding a post (or a room, or pausing on a patrol), they sweep their view scanAngle_deg either side
  // of its facing: a look one way, back to the middle, the other way and back, each held between
  // scanHoldMin_s and scanHoldMax_s. A marksman watching from a vantage sweeps it slowly and smoothly,
  // over 1.6 times scanPeriod_s.
  "scanAngle_deg": 35,
  "scanPeriod_s": 7,
  "scanHoldMin_s": 1.2,
  "scanHoldMax_s": 2.6,

  // How fast they turn when not aiming (aiming uses the tier's turn speed).
  "lookTurnSpeed_degps": 120,

  // The head turns ahead of the body, at headTurnSpeed_degps and up to movement.jsonc "maxHeadTurn_deg"
  // off the aim, so they look at a noise or round a corner before the body comes round (and see where
  // they look). With nothing going on (idle, on a post, on patrol, going back) they glance round every
  // glanceEveryMin_s to glanceEveryMax_s: glanceAngleMin_deg to glanceAngleMax_deg off the aim, either
  // way, held for glanceHoldMin_s to glanceHoldMax_s.
  "headTurnSpeed_degps": 300,
  "glanceEveryMin_s": 2.5,
  "glanceEveryMax_s": 7,
  "glanceAngleMin_deg": 20,
  "glanceAngleMax_deg": 55,
  "glanceHoldMin_s": 0.5,
  "glanceHoldMax_s": 1.4,

  // They refill from a pod when the loader drops below this share of full and nobody's in sight.
  "refillBelow": 0.4,

  // They hold fire while a teammate is this close to the line of fire.
  "teammateClearance_m": 0.7,

  // Aim: the error settles to a third of the tier's aim error over this long on a steady target, and
  // they pull the trigger once their aim is within aimTolerance_deg of where they mean to point it.
  "aimSettleTime_s": 1.5,
  "aimTolerance_deg": 1.5,

  // Eliminated, they walk to the dead zone and leave the field, at the latest after this long.
  "walkOffTime_s": 25,

  // Patrols, going back to a post and walking off after a hit are at a calm walk, this share of the
  // walking speed (movement.jsonc "walkSpeed_mps": 0.55 of 3 m/s is about 1.65 m/s). Investigating,
  // searching and hunting stay at the brisk walking speed.
  "strollPace": 0.55,

  // They shout (spotted you, lost you, under fire, refilling, hit) at most this often; you see it
  // as a subtitle when you're close enough to hear (presentation.jsonc "hud").
  "calloutCooldown_s": 4,

  // Hunting (hunters, and bots gone restless in free-for-all and teams): they walk the level's opponent
  // spawns one by one, picking the next at random from the huntChoices nearest they haven't visited
  // (1 = always the nearest), and look around for huntLookAround_s at each.
  "huntChoices": 3,
  "huntLookAround_s": 2,

  // Teamwork: a bot that spots someone shouts where they are, and teammates within calloutRange_m (half that
  // through walls) get it as a lead, give or take contactError_m; while it keeps them in sight it calls it again
  // every shareInterval_s. A call is worth acting on for contactMemory_s, even if they've heard something of the
  // enemy themselves since. Flankers go round to the side on a call; everyone else comes to help.
  "calloutRange_m": 35,
  "contactError_m": 2.5,
  "shareInterval_s": 3,
  "contactMemory_s": 4,

  // Marksmen moving on go at least relocateDistance_m from the spot they leave. A flanker's spot is at least
  // flankMinAngle_deg off the line between the enemy and the teammate who called them out; holding its fire on the
  // way there, it opens up once the enemy faces within noticedAngle_deg of it. At the spot it looks out from it for
  // flankLook_s (that's what the spot was picked for) before it starts searching (0 = searches straight away).
  "relocateDistance_m": 8,
  "flankMinAngle_deg": 50,
  "noticedAngle_deg": 57,
  "flankLook_s": 2.5,

  // Objectives (rules.jsonc "objectives"): bots on your side fetch the case, carry it to the nearest way out or keep
  // within escort_m of whoever carries it, or take a spot in the room to hold. Defenders sent to guard a spot (the way
  // out nearest the case, guarded from exitGuardInset_m inside it, or the case where it fell) stand guardSpacing_m apart.
  "escort_m": 5,
  "guardSpacing_m": 2.5,
  "exitGuardInset_m": 6,

  // Vantage (marksmen): each cover point is scored by how far you'd see from it, vantageRays rays of up to
  // vantageRange_m across vantageArc_deg of the side the cover faces, plus vantageHeightBonus_perM for every metre
  // above the ground (0.05 a metre: a 4 m mezzanine adds a fifth of a wide-open view).
  "vantageRays": 12,
  "vantageRange_m": 60,
  "vantageArc_deg": 140,
  "vantageHeightBonus_perM": 0.05,

  // Speedball (the field's points). At the horn the squad deals each side's bots a place: backShare of them at the back
  // and midShare in the middle (at least one of each when there are three or more), the rest up front; and each a bunker
  // of its side tagged for its place (the field's layouts tag them), spread over the snake side, the wedge side and
  // the centre. Each sprints to its bunker (a run lasting at most breakoutFor_s, then it fights from where it got to),
  // and fighting from cover prefers the spots at its own bunker by bunkerBias (a cover score: being able to shoot back
  // is worth 12). With advanceMargin more players in than the other side, a side moves one bot up a bunker, at most
  // one every advanceEvery_s. Every hangCheck_s the squad looks at the other side's buzzer: when none of them still in
  // can see it, the nearest bot goes and hangs it.
  "speedball": {
    "backShare": 0.2, "midShare": 0.4, "breakoutFor_s": 5, "bunkerBias": 14,
    "advanceMargin": 1, "advanceEvery_s": 5, "hangCheck_s": 0.5
  },

  // Capture the flag. With a flag for each side (the compound areas), at the horn the squad gives defendShare of each
  // side's bots (at least one, from two up) a post round their own flag, and sends the rest for the other side's. A bot
  // that takes a flag carries it to where its side scores, and the attackers escort it there. On the field (one flag in
  // the middle) everyone plays speedball, and every speedball hangCheck_s the squad sends a side's bot nearest the flag
  // to take it when none of the other side can see it, or when its side has more players in. When the other side
  // carries a flag, the chasers of a side nearest the carrier go after them, told where they are every alarmInterval_s;
  // a side's own flag dropped, its defenders guard it where it lies. Any bot within nearDropped_m of a dropped flag it
  // may take goes for it. A bot going for a flag, or carrying one, that has been in a fight for pressOnAfter_s without
  // it ending presses on for pressFor_s: on for the flag, or home with it, whatever it sees (one life each, two bots
  // peeking at each other from cover would otherwise hold the point up until time ran out).
  "flag": { "defendShare": 0.4, "chasers": 2, "alarmInterval_s": 4, "nearDropped_m": 12, "pressOnAfter_s": 12, "pressFor_s": 6 }
}
