// The level ladder: levels in play order, each harder than the last. Entries without a "file"
// are announced in level select but locked until they're built (Phase 3).
// Each playable level has difficulty tiers. A tier sets how good the bots are and what everyone
// carries; never how many there are (the mode and size are picked separately, see rules.jsonc "modes"):
//   bots         how good every bot is, teammates and opponents alike (a tier in bots/difficulty.jsonc)
//   timeLimit_s  how long the round lasts
//   startPods    full pods you start with (the loader starts full); botPods the same for every bot
//   pickups      whether the level's paint and air pickups are out
// roster: the opponent spawns scripted solo runs (smoke tests, demos) fill, in this order, so they play
// out the same every time. Real rounds deal random starts (rules.jsonc "spawning").
{
  // How the ladder opens: the first level is always open; each later one opens when you win a round on the
  // level before it, in any mode, on this tier or a harder one (later in that level's list; "" = any tier).
  // Settings → "Open every level" (or --unlock-all) opens them all without counting as wins.
  "unlock": { "minTier": "easy" },

  // Level select's records: accuracy only counts from rounds with at least this many shots.
  "records": { "accuracyMinShots": 10 },

  "levels": [
    {
      "id": "oxbarrow_works", "displayName": "Oxbarrow Works", "file": "levels/oxbarrow_works.jsonc",
      "tiers": [
        { "id": "easy", "displayName": "Easy", "bots": "easy", "timeLimit_s": 900, "startPods": 3, "botPods": 1, "pickups": true },
        { "id": "normal", "displayName": "Normal", "bots": "normal", "timeLimit_s": 900, "startPods": 2, "botPods": 2, "pickups": true },
        { "id": "hard", "displayName": "Hard", "bots": "hard", "timeLimit_s": 720, "startPods": 1, "botPods": 3, "pickups": true }
      ],
      "roster": [
        "guardhouse", "yard_containers", "yard_east", "office_corridor", "warehouse_floor", "warehouse_mezz_north",
        "office_up_south", "warehouse_bays", "pump_house", "east_scrap"
      ]
    },
    {
      "id": "rail_yard", "displayName": "The Rail Yard", "file": "levels/rail_yard.jsonc",
      "tiers": [
        { "id": "easy", "displayName": "Easy", "bots": "easy", "timeLimit_s": 840, "startPods": 2, "botPods": 1, "pickups": true },
        { "id": "normal", "displayName": "Normal", "bots": "normal", "timeLimit_s": 780, "startPods": 2, "botPods": 2, "pickups": true },
        { "id": "hard", "displayName": "Hard", "bots": "hard", "timeLimit_s": 660, "startPods": 1, "botPods": 3, "pickups": true }
      ],
      "roster": [
        "yard_office", "north_lane", "signal_box_up", "goods_track", "shed_floor", "south_lane", "footbridge_deck",
        "lamp_hut", "coal_stage", "west_end"
      ]
    },
    {
      "id": "cold_store", "displayName": "The Cold Store", "file": "levels/cold_store.jsonc",
      "tiers": [
        { "id": "easy", "displayName": "Easy", "bots": "easy", "timeLimit_s": 780, "startPods": 2, "botPods": 1, "pickups": true },
        { "id": "normal", "displayName": "Normal", "bots": "normal", "timeLimit_s": 720, "startPods": 1, "botPods": 2, "pickups": true },
        { "id": "hard", "displayName": "Hard", "bots": "hard", "timeLimit_s": 600, "startPods": 1, "botPods": 3, "pickups": true }
      ],
      "roster": [
        "dock_hall", "second_chamber", "office_up", "trailer", "aisle", "plant_room", "east_freezer", "gatehouse",
        "fourth_chamber", "lorry_park"
      ]
    },
    {
      "id": "hospital_wing", "displayName": "The Hospital Wing", "file": "levels/hospital_wing.jsonc",
      "tiers": [
        { "id": "easy", "displayName": "Easy", "bots": "easy", "timeLimit_s": 720, "startPods": 2, "botPods": 2, "pickups": true },
        { "id": "normal", "displayName": "Normal", "bots": "normal", "timeLimit_s": 660, "startPods": 1, "botPods": 2, "pickups": true },
        { "id": "hard", "displayName": "Hard", "bots": "hard", "timeLimit_s": 540, "startPods": 1, "botPods": 3, "pickups": true }
      ],
      "roster": [
        "outpatients", "theatre", "womens_ward", "courtyard", "main_entrance", "east_stairs", "pharmacy", "sun_ward",
        "boiler_house", "fallen_end"
      ]
    }
  ]
}
