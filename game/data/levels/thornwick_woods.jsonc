  "places": [
    { "id": "whole", "displayName": "The whole site", "still": "over the site", "description": "All of it, inside the fence: the four woods, the fields and hedges, the fort, the farm, the camp and the scrapyard, with buggies at the gate, the camp, the scrapyard and the north field. You come in at any of the four gates." },
    { "id": "farm", "displayName": "The farm", "still": "the farmyard", "description": "The south of the site: the barn, the farmhouse and the pump house round the farmyard, Hazel Copse and Long Spinney either side, and the hedge along the north. You come in at the south gate, where two buggies stand.", "rect_m": [-70, 30, 72, 134], "deadZone_m": [-14, 0, 130], "spawnScale": 0.6 },
    { "id": "north_field", "displayName": "The north field and the fort", "still": "the fort", "description": "The timber fort with its lookout, the open field round it and the hedge to the south. You come in at the north gate.", "rect_m": [-66, -134, 66, -56], "deadZone_m": [-14, 0, -130], "spawnScale": 0.6 },
    { "id": "blackthorn", "displayName": "Blackthorn Wood", "still": "in Blackthorn Wood", "description": "The big wood in the north-west: trees close enough to hide behind, a glade with a hut, bunkers of sandbags and pallets, and the ring track along its edge. You come in at the west gate.", "rect_m": [-184, -122, -60, -2], "deadZone_m": [-178, 0, -18], "spawnScale": 0.6 },
    { "id": "camp", "displayName": "The camp", "still": "the camp", "description": "The west of the site: containers, the guardhouse and the camp office in a square of sandbags, Hazel Copse to the south and the west track to the crossroads. You come in at the west gate, where a buggy stands.", "rect_m": [-184, -20, -60, 122], "deadZone_m": [-178, 0, 2], "spawnScale": 0.6 },
    { "id": "scrapyard", "displayName": "The scrapyard", "still": "the scrapyard", "description": "The east of the site: heaps of scrap and wrecks round the old boiler house, the quarry track and the edge of Rookery Wood. You come in at the east gate.", "rect_m": [60, -26, 184, 122], "deadZone_m": [178, 0, -2], "spawnScale": 0.6 }
