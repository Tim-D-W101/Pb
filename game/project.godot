; Engine configuration file.
; Godot 4.7.2 (.NET). Gameplay tunables live in data/*.jsonc, not here.

config_version=5

[application]

config/name="Pb (working title)"
config/description="First-person tactical paintball in an abandoned compound"
run/main_scene="res://scenes/Main.tscn"
run/flush_stdout_on_print=true
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.png"
config/quit_on_go_back=false

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1
window/handheld/orientation=4

[dotnet]

project/assembly_name="Pb"
project/solution_directory=".."

[physics]

common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=8
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.mobile=0
limits/cluster_builder/max_clustered_elements=4096
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/size.mobile=1024
occlusion_culling/use_occlusion_culling=true
occlusion_culling/use_occlusion_culling.mobile=false
textures/vram_compression/import_etc2_astc=true
