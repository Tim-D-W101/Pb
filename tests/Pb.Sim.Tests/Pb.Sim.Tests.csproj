<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pb.Sim\Pb.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <!-- The game's settings and bindings are plain C#, so they're tested here without the engine. -->
    <Compile Include="..\..\game\core\GameSettings.cs" Link="Game\GameSettings.cs" />
    <Compile Include="..\..\game\core\BindingSet.cs" Link="Game\BindingSet.cs" />
    <Compile Include="..\..\game\net\ServerDef.cs" Link="Game\ServerDef.cs" />
    <!-- Hit feedback's sums (Phase 5): the incoming-fire arcs and the near misses are plain C# too. -->
    <Compile Include="..\..\game\ui\IncomingFire.cs" Link="Game\IncomingFire.cs" />
    <Compile Include="..\..\game\ballistics\FlybyScan.cs" Link="Game\FlybyScan.cs" />
    <!-- The sound bank renders its recipes in plain C#, so the sounds' shapes are checked here too. -->
    <Compile Include="..\..\game\audio\Synth.cs" Link="Game\Synth.cs" />
    <Compile Include="..\..\game\audio\SoundBank.cs" Link="Game\SoundBank.cs" />
  </ItemGroup>
</Project>
