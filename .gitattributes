* text=auto eol=lf

*.cs      text diff=csharp
*.csproj  text
*.sln     text eol=crlf
*.tscn    text
*.tres    text
*.godot   text
*.gdshader text
*.jsonc   text
*.md      text
*.bat     text eol=crlf
*.ps1     text eol=crlf

# Binary game art/audio goes through Git LFS (Phase 5+). Install git-lfs before adding any of these.
game/assets/**/*.png filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.exr filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.hdr filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.wav filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.ogg filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.glb filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.blend filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.fbx filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.ttf filter=lfs diff=lfs merge=lfs -text
game/assets/**/*.otf filter=lfs diff=lfs merge=lfs -text

# Art imported by tools/art/import.sh is small so far and committed as plain files, so CI needs no LFS.
game/art/**/*.jpg binary
game/art/**/*.png binary
game/art/**/*.glb binary
