# Starts the Pb dedicated server with the machine, brings it up to date each time it starts, and starts it again if it
# stops (docs/hosting.md). It expects the server in /opt/pb-server, run by the user "pb": change WorkingDirectory,
# ExecStart and User if yours differ. Install it with
#   sudo cp /opt/pb-server/pb-server.service /etc/systemd/system/ && sudo systemctl enable --now pb-server
# then watch it with: journalctl -u pb-server -f
[Unit]
Description=Pb dedicated server
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pb
WorkingDirectory=/opt/pb-server
ExecStart=/opt/pb-server/run-server.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
