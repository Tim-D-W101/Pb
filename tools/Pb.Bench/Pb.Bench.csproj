<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless ball-count benchmark. Run with: dotnet run -c Release (from tools/Pb.Bench) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The game's JIT settings (game/Pb.csproj), so the numbers are the game's. -->
    <TieredPGO>false</TieredPGO>
    <TieredCompilationQuickJitForLoops>false</TieredCompilationQuickJitForLoops>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Pb.Sim\Pb.Sim.csproj" />
    <ProjectReference Include="..\..\src\Pb.Net\Pb.Net.csproj" />
  </ItemGroup>
</Project>
